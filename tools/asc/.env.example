# Copier en .env (ignoré par git) et remplir.
# Clé API : App Store Connect → Utilisateurs et accès → Intégrations → Clés API.
# Rôle minimal : App Manager. Le fichier .p8 n'est téléchargeable qu'une fois.

ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_PATH=AuthKey_XXXXXXXXXX.p8
# variante CI : le .p8 encodé en base64 (base64 -i AuthKey_XXX.p8)
# ASC_KEY_B64=

# L'un des deux suffit ; ASC_APP_ID évite une requête.
ASC_BUNDLE_ID=com.vahanlab.sunmap
# ASC_APP_ID=1234567890

# Optionnel
# ASC_PLATFORM=IOS
# ASC_VERSION_ID=          # force une version précise au lieu de celle en préparation
# ASC_METADATA_DIR=metadata
# ASC_SCREENSHOTS_DIR=screenshots
